# Copier ce fichier en .env puis renseigner les valeurs.
# docker compose lit .env automatiquement. Sans .env, l'application démarre en mode simulé.

# Fournisseur d'agenda : google en production, mock pour essayer sans compte Google.
CALENDAR_PROVIDER=google

# Nom de domaine public. Caddy obtient le certificat HTTPS automatiquement.
# Le DNS du domaine doit pointer vers la VM, ports 80 et 443 ouverts.
DOMAIN=rdv.exemple.fr

# URL publique complète, sans chemin. Par défaut : https://$DOMAIN.
# Sert aux liens d'annulation et de reprogrammation et à l'URI de redirection OAuth
# (BASE_URL/auth/google/callback, à déclarer dans Google Cloud).
# BASE_URL=https://rdv.exemple.fr

# Adresses Google autorisées à se connecter à /admin, séparées par des virgules.
ADMIN_EMAILS=moi@exemple.fr

# Identifiants du client OAuth « Application Web » créé dans Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clé de chiffrement des refresh tokens, 32 octets en base64 :
#   openssl rand -base64 32
# Requise en mode google. La changer rend les comptes connectés illisibles : il faudra les reconnecter.
ENCRYPTION_KEY=

# Données de démonstration au premier démarrage, uniquement en mode simulé.
DEMO_SEED=false

# Niveau de journalisation sur la sortie standard : debug, info, warn, error.
LOG_LEVEL=info

# Variables lues par l'application hors Docker (npm start). Docker fixe déjà ces valeurs.
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=./data
# Lire l'adresse du client dans X-Forwarded-For (derrière un reverse proxy uniquement).
# TRUST_PROXY=true

# docker-compose.proxy.yml : port local d'écoute, sur 127.0.0.1.
# APP_PORT=3000
